---
import type { HomeCopy } from '../data/types';
import { services } from '../data/services';
interface Props { c: HomeCopy; other: string }
const { c, other } = Astro.props;
const f = c.footer;
const lang = c.lang;
const comp = [`/${lang}/work/`, `/${lang}/packages/`, `/${lang}/about/`, `/${lang}/contact/`];
import { contact, SAMPLE, sampleLabel, tbc } from '../data/placeholders';
import SampleTag from './SampleTag.astro';
---
<footer class="footer on-dark">
  <div class="container">
    <div class="footer__top">
      <div class="footer__brand">
        <img src="/images/logo/gate33-logo-white.svg" width="135" height="18" alt="Gate33" />
        <p>{f.tagline}</p>
      </div>
      <div class="footer__cols">
        <div class="footer__col footer__col--wide"><h2>{f.services}</h2><ul>{services.map((s) => <li><a href={`/${lang}/services/${s.slug}/`}>{s.name[lang]}</a></li>)}</ul></div>
        <div class="footer__col"><h2>{f.company}</h2><ul>{f.companyLinks.map((l, i) => <li><a href={comp[i]}>{l}</a></li>)}</ul></div>
        <div class="footer__col"><h2>{f.contact}</h2><ul>
          <!-- Sample contact details (placeholders.ts) until Shifaa confirms them. Phone / WhatsApp are never invented. -->
          <li><span dir="ltr">{contact.email.value}</span></li><li><span>{contact.city.value[lang]}</span></li>
          <li><span>{contact.hours.value[lang]}</span></li>
          <li><a href={contact.instagram.url} target="_blank" rel="noopener" dir="ltr">Instagram {contact.instagram.handle}</a></li>
          <li><span class="footer__tbc">{lang === 'en' ? 'Phone / WhatsApp' : 'الهاتف / واتساب'}: {tbc[lang]}</span></li>
          {SAMPLE && <li class="footer__sample"><SampleTag lang={lang} /></li>}
          <li><a href={`/${lang}/contact/#contact-form`} data-open-drawer>{f.brief}</a></li></ul></div>
      </div>
    </div>
    <div class="footer__bottom">
      <p>{f.rights}</p>
      <p class="footer__legal"><a href={`/${lang}/privacy/`}>{f.privacy}</a><a href={`/${lang}/terms/`}>{f.terms}</a><a href={other} hreflang={lang === 'en' ? 'ar' : 'en'} lang={lang === 'en' ? 'ar' : 'en'}>{c.switchLabel}</a></p>
    </div>
  </div>
</footer>
