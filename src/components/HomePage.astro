---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import Button from './Button.astro';
import Icon from './Icon.astro';
import WorkCard from './WorkCard.astro';
import PackageCard from './PackageCard.astro';
import AskGate from './AskGate.astro';
import Drawer from './Drawer.astro';
import Picture from './Picture.astro';
import { images, videos } from '../data/media';
import { clients, isTodo } from '../data/clients';
import { services } from '../data/services';
import { cases } from '../data/work';
import type { HomeCopy } from '../data/types';
import SampleTag from './SampleTag.astro';
import Testimonial from './Testimonial.astro';
import { packages as pkgSamples, SAMPLE } from '../data/placeholders';
interface Props { c: HomeCopy }
const { c } = Astro.props;
const lang = c.lang;
const other = lang === 'en' ? '/ar/' : '/en/';
// Logos are sized by optical area (not by box), so a tall calligraphic mark and a long wordmark feel equally heavy.
const AREA = 6200, MAXW = 150, MAXH = 78;
const logoSize = (w: number, h: number) => {
  const r = w / h; let dw = Math.sqrt(AREA * r), dh = dw / r;
  if (dw > MAXW) { dw = MAXW; dh = dw / r; }
  if (dh > MAXH) { dh = MAXH; dw = dh * r; }
  return { w: Math.round(dw), h: Math.round(dh) };
};
---
<BaseLayout lang={lang} title={c.meta.title} description={c.meta.description}>
  <a class="skip" href="#main">{c.ui.skip}</a>
  <Header c={c} other={other} />
  <main id="main">
    <!-- HERO: muted background reel (autoplay muted loop playsinline), poster first; paused off-screen; reduced motion = poster only -->
    <section class="hero" aria-labelledby="hero-title" data-hero>
      <!-- Gate panels (motion only): two lavender leaves left/right of the reel that slide apart on scroll. Hidden without JS / reduced motion. -->
      <div class="hero__media" aria-hidden="true">
        <Picture img={images.hero} lang={lang} class="hero__poster" loading="eager" fetchpriority="high" sizes="100vw" />
        <video class="hero__video" autoplay muted loop playsinline preload="metadata" tabindex="-1" data-hero-video>
          <source src={videos.hero.mobile} type="video/mp4" media="(max-width: 768px)" />
          <source src={videos.hero.desktop} type="video/mp4" />
        </video>
        <div class="hero__shade"></div>
      </div>
      <div class="container hero__content">
        <p class="hero__eyebrow">{c.hero.eyebrow}</p>
        <h1 class="hero__title" id="hero-title">{c.hero.headline.map((l) => <span>{l}</span>)}</h1>
        <div class="hero__row">
          <p class="hero__lede">{c.hero.lede}</p>
          <div class="hero__actions">
            <Button variant="light" arrow data-open-drawer>{c.hero.cta}</Button>
            <button class="btn btn--ghost" type="button" data-open-panel aria-haspopup="dialog"><Icon name="gate" />{c.askGate}</button>
          </div>
        </div>
      </div>
      <div class="container hero__foot">
        <nav class="hero__services" aria-label={c.hero.servicesLabel}>
          <p class="hero__services-label">{c.hero.servicesLabel}</p>
          <ul>{services.map((s) => <li><a href={`/${lang}/services/${s.slug}/`}>{s.name[lang]}</a></li>)}</ul>
        </nav>
        <button class="hero__toggle" type="button" data-hero-toggle aria-label={c.hero.pause} data-label-pause={c.hero.pause} data-label-play={c.hero.play}>
          <Icon name="pause" class="hero__ico-pause" /><Icon name="play" class="hero__ico-play" />
        </button>
      </div>
    </section>

    <!-- INTRO + CLIENTS -->
    <section class="clients-sec" aria-labelledby="clients-title">
      <div class="container">
        <p class="statement" data-fill>{c.intro}</p>
        <div class="clients__head">
          <p class="overline" data-reveal="fade">{c.clients.eyebrow}</p>
          <h2 class="h2" id="clients-title" data-reveal="fade">{c.clients.title}</h2>
        </div>
        <ul class="clients" data-clients>
          {clients.map((k, i) => {
            const logo = lang === 'ar' && k.logoAr ? k.logoAr : k.logo;
            const s = logoSize(lang === 'ar' && k.wAr ? k.wAr : k.w, lang === 'ar' && k.hAr ? k.hAr : k.h);
            const inner = (
              <>
                <span class="client__logo">
                  <img class="client__ink" src={`/images/clients/${logo}-ink.webp`} width={s.w} height={s.h} alt={k.name[lang]} loading="lazy" decoding="async" />
                  <img class="client__color" src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" data-src={`/images/clients/${logo}-color.webp`} width={s.w} height={s.h} alt="" aria-hidden="true" loading="lazy" decoding="async" />
                </span>
                <span class="client__cap" aria-hidden="true">
                  <span class="client__name">{k.name[lang]}</span>
                  {!isTodo(k.sector[lang]) && <span class="client__sector">{k.sector[lang]}</span>}
                </span>
              </>
            );
            return (
              <li class="client">
                {k.caseSlug ? <a class="client__in" href={`/${lang}/work/${k.caseSlug}/`} aria-label={`${k.name[lang]} · ${c.clients.viewCase}`}>{inner}</a> : <div class="client__in">{inner}</div>}
              </li>
            );
          })}
        </ul>
      </div>
    </section>

    <!-- SELECTED WORK -->
    <section class="section work-sec" id="work" aria-labelledby="work-title">
      <div class="container">
        <div class="sec-head">
          <div>
            <p class="overline" data-reveal="fade">{c.work.eyebrow}</p>
            <h2 class="h2 sec-head__title" id="work-title" data-reveal="fade">{c.work.title}</h2>
          </div>
          <Button variant="link" href={`/${lang}/work/`} arrow data-reveal="fade" data-reveal-delay="250">{c.work.all}</Button>
        </div>
        <div class="works" data-works>
          {cases.map((k, i) => <WorkCard k={k} lang={lang} viewCase={c.work.viewCase} play={c.work.play} delay={(i % 2) * 90} />)}
          <a class="work-more" href={`/${lang}/work/`}>
            <ul class="work-more__marks" aria-hidden="true">
              {clients.slice(5, 11).map((k) => <li><img src={`/images/clients/${k.logo}-ink.webp`} alt="" width={k.w} height={k.h} loading="lazy" decoding="async" /></li>)}
            </ul>
            <span class="work-more__title">{c.work.moreTitle}</span>
            <span class="work-more__line">{c.work.moreLine}</span>
            <span class="work-more__cta">{c.work.moreCta}<Icon name="arrow" /></span>
          </a>
        </div>
      </div>
    </section>

    <!-- SERVICES (dark) -->
    <section class="section services-sec on-dark" id="services" aria-labelledby="services-title">
      <div class="container">
        <div class="services__head">
          <div>
            <p class="overline" data-reveal="fade">{c.services.eyebrow}</p>
            <h2 class="h2 sec-head__title" id="services-title" data-reveal="fade">{c.services.title}</h2>
            <p class="services__line" data-reveal="fade" data-reveal-delay="250">{c.services.line}</p>
          </div>
          <p class="services__lead" data-reveal="fade" data-reveal-delay="350">{c.services.lead}</p>
        </div>
        <ul class="svcs" data-svcs>
          {services.map((s, i) => (
            <li>
              <a class="svc" href={`/${lang}/services/${s.slug}/`}>
                <h3 class="svc__name">{s.name[lang]}</h3>
                <p class="svc__promise">{s.promise[lang]}</p>
                <ul class="svc__subs">{s.subs.map((x) => <li>{x[lang]}</li>)}</ul>
                <span class="svc__more">{c.services.explore}<Icon name="arrow" /></span>
              </a>
            </li>
          ))}
          <li>
            <button class="svc svc--ask" type="button" data-open-panel data-ask-intent="packages" aria-haspopup="dialog">
              <span class="mark"><Icon name="gate" /></span>
              <span class="svc__name">{c.services.askTitle}</span>
              <span class="svc__promise">{c.services.askLine}</span>
              <span class="svc__more">{c.services.askCta}<Icon name="arrow" /></span>
            </button>
          </li>
        </ul>
        <p class="swipe-note">{c.services.swipe}</p>
      </div>
    </section>

    <!-- PACKAGES -->
    <section class="section" id="packages" aria-labelledby="packages-title">
      <div class="container">
        <div class="sec-head">
          <div>
            <p class="overline" data-reveal="fade">{c.packages.eyebrow}</p>
            <h2 class="h2 sec-head__title" id="packages-title" data-reveal="fade">{c.packages.title}</h2>
          </div>
          <p class="sec-head__line" data-reveal="fade" data-reveal-delay="250">{c.packages.line}</p>
        </div>
        <div class="pkgs" data-pkgs>
          {c.packages.items.map((p, i) => (
            <PackageCard pkg={p} popular={c.packages.popular} from={c.packages.from} price={c.packages.price} priceNote={c.packages.priceNote} vat={c.packages.vat} buy={c.packages.buy} delay={i * 80} sample={pkgSamples[i]?.value} lang={lang} />
          ))}
        </div>
        <p class="swipe-note swipe-note--pkg">{c.packages.swipe}</p>
        <p class="pkgs__note">{c.packages.reassurance}</p>
      </div>
    </section>

    <!-- PROCESS + NUMBERS -->
    <section class="section how-sec" id="how" aria-labelledby="how-title">
      <div class="container">
        <div class="sec-head">
          <div>
            <p class="overline" data-reveal="fade">{c.how.eyebrow}</p>
            <h2 class="h2 sec-head__title" id="how-title" data-reveal="fade">{c.how.title}</h2>
          </div>
        </div>
        <div class="steps-wrap" data-steps>
        <span class="steps__line" aria-hidden="true"></span>
        <ol class="steps">
          {c.how.steps.map((s, i) => (
            <li class="step">
              <span class="step__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="step__title">{s.title}</h3>
              <p class="step__line">{s.line}</p>
            </li>
          ))}
        </ol>
        </div>
        <!-- RESULTS: real figures confirmed by Shifaa (19 Nov), from home.<lang>.ts. No Sample marker. -->
        <div class="numbers reveal" role="group" aria-labelledby="numbers-title">
          <div class="numbers__head"><h2 class="numbers__title" id="numbers-title">{c.results.eyebrow}</h2></div>
          <ul class="numbers__list">
            {c.results.stats.map((s, i) => {
              const v = s.value;
              return (
                <li class="num">
                  {isTodo(v) ? <span class="num__value num__value--todo" aria-hidden="true">—</span> : <span class="num__value">{v}</span>}
                  <span class="num__label">{s.label}</span>
                </li>
              );
            })}
          </ul>
          <p class="numbers__note">{c.results.note}</p>
        </div>
        <Testimonial lang={lang} id="home" over={lang === 'en' ? 'What clients say' : 'ماذا يقول عملاؤنا'} />
      </div>
    </section>

    <!-- FINAL CTA (dark, flows into the footer) -->
    <section class="cta-sec on-dark" id="contact" aria-labelledby="cta-title">
      <div class="container">
        <p class="overline" data-reveal="fade">{c.cta.eyebrow}</p>
        <h2 class="cta__title" id="cta-title" data-reveal="lines" data-cta-scale>{c.cta.title}</h2>
        <div class="cta__row reveal" data-delay="90">
          <p class="cta__line">{c.cta.line}</p>
          <div class="cta__actions">
            <Button variant="light" arrow data-open-drawer>{c.cta.button}</Button>
            <button class="btn btn--ghost" type="button" data-open-panel aria-haspopup="dialog"><Icon name="gate" />{c.cta.ask}</button>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer c={c} other={other} />
  <AskGate c={c} />
  <Drawer c={c} />
</BaseLayout>
