---
// Work index (/<lang>/work/), Stage 4B-1. Copy: work-page.ts · projects: work.ts · logo archive: clients.ts.
// Sections and their one motion idea (src/scripts/motion/work.js): hero = masked line rise (shared page intro) ·
// featured Cyrin frame = icon slices (icon.js, the only data-slices on the page) · project grid = cards rise while the
// image glides the other way inside its frame · logo archive = marks settle in a diagonal wave · final CTA = masked lines + scale.
// Filters (src/scripts/work-filter.js): real buttons with aria-pressed, ?type= in the URL, live count; the bar stays hidden
// without JS, so no-JS visitors see every project and the whole archive.
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import Button from './Button.astro';
import Icon from './Icon.astro';
import AskGate from './AskGate.astro';
import Drawer from './Drawer.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import WorkCard from './WorkCard.astro';
import { cases } from '../data/work';
import { clients, isTodo } from '../data/clients';
import { workPage } from '../data/work-page';
import type { HomeCopy } from '../data/types';
interface Props { c: HomeCopy }
const { c } = Astro.props;
const lang = c.lang;
const x = workPage(lang);
const other = lang === 'en' ? '/ar/work/' : '/en/work/';
// Grid order: featured Cyrin, two pairs around the full-width film (DOM order = visual order).
const order = ['cyrin', 'plutrex', 'zakharef', 'coffee-film', 'the-point', 'abdo'];
const projects = order.map((s) => cases.find((k) => k.slug === s)!).filter(Boolean);
const n2 = (i: number) => String(i + 1).padStart(2, '0');
// What each filter shows: projects of that type; "logo" shows the logo archive (the Logo Design body of work).
const shown = (id: string) => ({
  p: id === 'logo' ? 0 : projects.filter((k) => id === 'all' || k.types.includes(id as never)).length,
  l: id === 'all' || id === 'logo' ? clients.length : 0,
});
const size = (k: (typeof projects)[number], i: number) => (i === 0 ? 'feature' : k.layout === 'cinema' ? 'wide' : 'half');
const sizes = { feature: '(max-width: 899px) 100vw, 1360px', wide: '(max-width: 899px) 100vw, 1360px', half: '(max-width: 899px) 100vw, 680px' };
---
<BaseLayout lang={lang} title={x.meta.title} description={x.meta.description} path="work/">
  <a class="skip" href="#main">{c.ui.skip}</a>
  <Header c={c} other={other} ink />
  <main id="main">
    <section class="page-hero page-hero--index" aria-labelledby="page-title" data-page-hero>
      <div class="container">
        <div class="ph-part"><Breadcrumbs label={x.ui.breadcrumb} items={[{ name: x.ui.home, href: `/${lang}/` }, { name: x.ui.work }]} /></div>
        <div class="page-hero__grid">
          <div class="page-hero__text">
            <p class="overline ph-part">{x.overline}</p>
            <h1 class="page-hero__title page-hero__title--work" id="page-title">{x.headline}</h1>
          </div>
        </div>
        <div class="page-hero__row">
          <p class="page-hero__intro ph-part">{x.intro}</p>
          <div class="page-hero__side">
            <p class="page-hero__count ph-part" aria-hidden="true"><span>{String(projects.length).padStart(2, '0')}</span></p>
            <div class="page-hero__actions ph-part">
            <Button variant="primary" arrow data-open-drawer>{x.cta}</Button>
            <button class="btn btn--secondary" type="button" data-open-panel data-ask-intent="work" aria-haspopup="dialog"><Icon name="gate" />{x.ctaAsk}</button>
          </div>
          </div>
        </div>
      </div>
    </section>

    <!-- PROJECTS: filter bar + grid (featured Cyrin, pairs, full-width film) -->
    <section class="windex-sec" aria-labelledby="windex-title" data-wfilter-root>
      <div class="container">
        <div class="wfilter" data-wfilter hidden>
          <p class="wfilter__label" id="wfilter-label">{x.filterLabel}</p>
          <div class="wfilter__btns" role="group" aria-labelledby="wfilter-label">
            {x.filters.map((f) => {
              const s = shown(f.id);
              return (
                <button class="wchip" type="button" data-filter={f.id} aria-pressed={f.id === 'all' ? 'true' : 'false'} data-count={x.count(s.p, s.l)}>
                  {f.label}<span class="wchip__n" aria-hidden="true">{f.id === 'logo' ? s.l : s.p}</span>
                </button>
              );
            })}
          </div>
          <p class="wfilter__count" data-wcount aria-live="polite" aria-atomic="true">{x.count(shown('all').p, shown('all').l)}</p>
        </div>

        <h2 class="visually-hidden" id="windex-title">{x.gridLabel}</h2>
        <ul class="windex" data-windex>
          {projects.map((k, i) => (
            <li class={`windex__item windex__item--${size(k, i)}`} data-types={k.types.join(' ')}>
              <WorkCard k={k} lang={lang} viewCase={x.viewCase} play={x.play} slices={i === 0} sizes={sizes[size(k, i)]} />
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- LOGO ARCHIVE: the Logo Design body of work (clients.ts; TODO values never rendered) -->
    <section class="section archive-sec" id="logos" aria-labelledby="archive-title" data-archive>
      <div class="container">
        <div class="sec-head">
          <div>
            <p class="overline" data-reveal="fade">{x.archiveOver}</p>
            <h2 class="h2 sec-head__title" id="archive-title" data-reveal="fade">{x.archiveTitle}</h2>
          </div>
          <p class="sec-head__line" data-reveal="fade" data-reveal-delay="200">{x.archiveLine}</p>
        </div>
        <ol class="archive" data-archive-list>
          {clients.map((k, i) => {
            const ar = lang === 'ar' && k.logoAr;
            const logo = ar ? k.logoAr : k.logo;
            const w = ar ? k.wAr! : k.w, h = ar ? k.hAr! : k.h;
            const inner = (
              <>
                <span class="arch__num" aria-hidden="true">{n2(i)}</span>
                <span class="arch__logo"><img src={`/images/clients/${logo}-ink.webp`} width={w} height={h} alt="" loading="lazy" decoding="async" /></span>
                <span class="arch__cap">
                  <span class="arch__name">{k.name[lang]}</span>
                  {!isTodo(k.sector[lang]) && <span class="arch__sector">{k.sector[lang]}</span>}
                </span>
                {k.caseSlug && <span class="arch__case">{x.archiveCase}<Icon name="arrow" /></span>}
              </>
            );
            return (
              <li class="arch">
                {k.caseSlug ? <a class="arch__in" href={`/${lang}/work/${k.caseSlug}/`}>{inner}</a> : <div class="arch__in">{inner}</div>}
              </li>
            );
          })}
        </ol>
      </div>
    </section>

    <!-- FINAL CTA (dark, flows into the footer) -->
    <section class="cta-sec on-dark" id="contact" aria-labelledby="cta-title">
      <div class="container">
        <p class="overline" data-reveal="fade">{x.ctaOver}</p>
        <h2 class="cta__title" id="cta-title" data-reveal="lines" data-cta-scale>{x.ctaTitle}</h2>
        <div class="cta__row">
          <p class="cta__line">{x.ctaBody}</p>
          <div class="cta__actions">
            <Button variant="light" arrow data-open-drawer>{x.ctaBrief}</Button>
            <button class="btn btn--ghost" type="button" data-open-panel aria-haspopup="dialog"><Icon name="gate" />{x.ctaAskGate}</button>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer c={c} other={other} />
  <AskGate c={c} />
  <Drawer c={c} />
  <script>import '../scripts/work-filter.js';</script>
</BaseLayout>
