---
// Inline SVG icons (2px line, square caps). Arrows mirror in RTL via .icon--flip.
const { name, class: cls = '' } = Astro.props as { name: string; class?: string };
const flip = ['arrow', 'chevron'].includes(name) ? 'icon--flip' : '';
---
<svg class={`icon icon--${name} ${flip} ${cls}`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true" focusable="false">
  {name === 'arrow' && <path d="M4 12h15M13 6l6 6-6 6" />}
  {/* 13 Nov (Ahmed): the Gate33 icon replaces the AI sparkle everywhere (Ask Gate buttons, marks, contact route). */}
  {name === 'gate' && <g transform="translate(0.34 0) scale(0.05279) translate(-319.19 -312.68)" fill="currentColor" stroke="none"><path d="M 630.710938 767.316406 L 540 767.316406 L 540 679.324219 L 670.101562 553.125 L 760.8125 553.125 L 760.8125 641.117188 Z M 630.710938 767.316406" /><path d="M 682.230469 553.125 L 591.519531 553.125 L 591.519531 465.132812 L 670.097656 388.910156 L 760.8125 388.910156 L 760.8125 476.902344 Z M 682.230469 553.125" /><path d="M 540 388.910156 L 670.101562 388.910156 L 670.101562 312.683594 L 540 312.683594 Z M 540 388.910156" /><path d="M 409.898438 767.316406 L 319.1875 767.316406 L 319.1875 679.324219 L 449.289062 553.125 L 540 553.125 L 540 641.117188 Z M 409.898438 767.316406" /><path d="M 461.417969 553.125 L 370.707031 553.125 L 370.707031 465.132812 L 449.289062 388.910156 L 540 388.910156 L 540 476.902344 Z M 461.417969 553.125" /><path d="M 319.1875 388.910156 L 449.289062 388.910156 L 449.289062 312.683594 L 319.1875 312.683594 Z M 319.1875 388.910156" /></g>}
  {name === 'tick' && <path d="m5 12.5 4.5 4.5L19 7.5" stroke-width="2.6" />}
  {name === 'menu' && <path d="M3 7h18M3 17h18" />}
  {name === 'chevron' && <path d="m9 5 7 7-7 7" />}
  {name === 'close' && <path d="M5 5l14 14M19 5 5 19" />}
  {name === 'pause' && <path d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z" fill="currentColor" stroke="none" />}
  {name === 'play' && <path d="M7 4.5v15l12-7.5z" fill="currentColor" stroke="none" />}
  {name === 'send' && <path d="M21 3 3 10.5l7 3 3 7zM10 13.5 21 3" stroke-linejoin="round" stroke-linecap="round" stroke-width="1.8" />}
  {name === 'doc' && <path d="M6 3h8l4 4v14H6zM14 3v4h4M9 12h6M9 16h6" stroke-width="1.6" />}
  {name === 'calendar' && <path d="M4 6h16v14H4zM4 10h16M8 3v5M16 3v5" stroke-width="1.6" />}
  {name === 'chat' && <path d="M5 18.5 3.5 21l.8-4.2A8.5 8.5 0 1 1 8 19.5z" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round" />}
</svg>
